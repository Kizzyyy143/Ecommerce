{
  "name": "khmer-store",
  "version": "1.0.0",
  "private": true,
  "description": "Fullstack Khmer Store E-Commerce with React & Bakong KHQR",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node --watch backend/server.js",
    "client": "npm --prefix frontend run dev",
    "build:client": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "dependencies": {
    "bakong-khqr": "^1.0.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "qrcode": "^1.5.4"
  }
}
